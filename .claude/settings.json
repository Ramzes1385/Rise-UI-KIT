{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run -s lint:new)",
      "Bash(npm run lint:new)",
      "Bash(npm run lint:styles)",
      "Bash(npm run lint:unused)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npx vue-tsc -b)",
      "Bash(npx eslint *)",
      "Bash(npx stylelint *)",
      "Bash(npx prettier --check *)",
      "Bash(npm run test:unit *)",
      "Bash(npx vitest run *)",
      "Bash(npx cross-env CI=true vitest run *)",
      "Bash(npm run test:components:coverage)",
      "Bash(npm run test:components-heavy:coverage)",
      "Bash(npm run test:composables:coverage)",
      "Bash(npm run test:utils:coverage)",
      "Bash(npm run test:l10n)",
      "Bash(npm run test:stories-coverage)",
      "Bash(npm run test:a11y:coverage)",
      "Bash(npm run test:story-source *)",
      "Bash(npm run test:contrast)",
      "Bash(npx storybook build --config-dir build/storybook -o storybook-static --quiet)",
      "Bash(npm run build-storybook *)",
      "Bash(node scripts/serve-storybook-static.mjs *)",
      "Bash(node scripts/check-stories.mjs *)",
      "Bash(node scripts/portion-scope.mjs)",
      "Bash(node scripts/portion-scope.mjs *)",
      "Bash(npx vue-tsc -p build/lib/tsconfig.lib.json --noEmit)",
      "Bash(npm run test:slot-docs)",
      "Bash(npx playwright test --config build/tests/playwright.config.ts --project=visual-chromium --update-snapshots=none *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run build)",
      "Bash(npm run pack:dry)",
      "Bash(npm run ci:validate)",
      "Bash(npm run create:component *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm run format)",
      "Bash(npm run lint:fix)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/docs/v2/PLAN.md)"
    ],
    "deny": [],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(npm run release*)",
      "Bash(npm run ci:release*)",
      "Bash(npx semantic-release *)",
      "Bash(npm run test:visual:update*)",
      "Bash(* --update-snapshots)",
      "Bash(* --update-snapshots *)",
      "Bash(* --update-snapshots=all*)",
      "Bash(* --update-snapshots=changed*)",
      "Bash(* --update-snapshots=missing*)",
      "Read(/.kilo/**)"
    ]
  },
  "enabledPlugins": {
    "context7@context7-marketplace": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true
  }
}
