  "scripts": {
    "prepare": "husky build/husky",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:styles": "stylelint \"src/**/*.scss\" && node scripts/check-component-tokens.mjs",
    "lint:unused": "knip --no-config-hints",
    "lint:new": "node scripts/lint-new-files.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "storybook": "node scripts/storybook-dev.mjs",
    "build-storybook": "storybook build --config-dir build/storybook",
    "typecheck": "vue-tsc -b",
    "test:codemod": "vitest run --config build/tests/vitest.config.ts --project unit-integration --maxWorkers=1 build/tests/codemod --coverage --coverage.reportsDirectory=coverage/codemod --coverage.include=bin/migrate/*.mjs --coverage.thresholds.100",
    "test:codemod-app": "node scripts/check-codemod-app.mjs",
    "test:unit": "vitest run --config build/tests/vitest.config.ts --project unit-integration",
    "test:a11y:coverage": "node scripts/check-a11y-coverage.mjs",
    "test:stories": "node scripts/check-stories.mjs",
    "test:rtl": "node scripts/check-rtl.mjs",
    "test:stories-coverage": "node scripts/check-stories-coverage.mjs",
    "test:contrast": "node scripts/check-contrast.mjs --theme=all",
    "test:l10n": "node scripts/check-l10n.mjs",
    "test:story-source": "node scripts/check-story-source.mjs",
    "test:slot-docs": "node scripts/check-slot-docs.mjs",
    "test:ratchets": "node scripts/check-ratchets.mjs",
    "test:fuzz": "node scripts/run-fuzz.mjs",
    "test:css-split": "node scripts/check-css-split.mjs",
    "test:subpaths": "node scripts/generate-subpath-exports.mjs --check && node scripts/check-subpaths-app.mjs",
    "test:autoimport": "node scripts/check-autoimport-app.mjs",
    "generate:subpath-exports": "node scripts/generate-subpath-exports.mjs",
    "report:sizes": "node scripts/report-sizes.mjs",
    "test:sizes": "node scripts/report-sizes.mjs --check",
    "test:folders": "node scripts/check-folder-size.mjs",
    "test:custom-color": "node scripts/check-custom-color-scope.mjs",
    "create:component": "node scripts/create-component.mjs",
    "generate:emoji-data": "node scripts/generate-emoji-data.mjs",
    "pretest:components:coverage": "node scripts/invalidate-merged-coverage.mjs",
    "test:components:coverage": "cross-env COVERAGE_MODE=components CI=true NODE_OPTIONS=--max-old-space-size=16384 vitest run --config build/tests/vitest.config.ts --project unit-integration --coverage --coverage.include=src/components/**/*.vue --coverage.include=src/components/**/model/use*.ts --coverage.include=src/components/BaseConfirm/useConfirm.ts --coverage.exclude=src/components/BaseChat/** --coverage.exclude=src/components/BaseTable/** --coverage.exclude=src/components/BaseEditor/** --coverage.exclude=src/components/BaseCalendar/** --coverage.exclude=src/components/BaseDatePicker/** --coverage.exclude=src/components/BaseFileUpload/** --coverage.exclude=src/components/BaseImage/** --coverage.exclude=src/components/BaseSelect/** --coverage.exclude=src/components/BaseSlider/** --coverage.exclude=src/components/BaseRange/** --coverage.exclude=src/components/BaseTabs/** --coverage.exclude=src/components/BaseTooltip/** --coverage.exclude=src/components/BaseTree/** --coverage.exclude=src/components/BaseSlideover/** --coverage.exclude=src/components/BaseButton/** --coverage.exclude=src/components/BaseCheckbox/** --coverage.exclude=src/components/BaseColorPicker/** --coverage.exclude=src/components/BaseFormField/** --coverage.exclude=src/components/BasePin/** --coverage.exclude=src/components/BaseRadio/** --coverage.exclude=src/components/BaseSearch/** --coverage.exclude=src/components/BaseSwitch/** --coverage.exclude=src/components/BaseTextarea/** --coverage.thresholds.lines=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100 --coverage.thresholds.branches=0 --coverage.thresholds.perFile",
    "pretest:composables:coverage": "node scripts/invalidate-merged-coverage.mjs",
    "test:composables:coverage": "cross-env COVERAGE_MODE=composables CI=true NODE_OPTIONS=--max-old-space-size=16384 vitest run --config build/tests/vitest.config.ts --project unit-integration --coverage --coverage.reportsDirectory=coverage/composables --coverage.thresholds.100 --coverage.thresholds.perFile",
    "pretest:utils:coverage": "node scripts/invalidate-merged-coverage.mjs",
    "test:utils:coverage": "cross-env COVERAGE_MODE=utils CI=true NODE_OPTIONS=--max-old-space-size=16384 vitest run --config build/tests/vitest.config.ts --project unit-integration --coverage --coverage.reportsDirectory=coverage/utils --coverage.thresholds.100 --coverage.thresholds.perFile",
    "pretest:components-heavy:coverage": "node scripts/invalidate-merged-coverage.mjs",
    "test:components-heavy:coverage": "cross-env CI=true NODE_OPTIONS=--max-old-space-size=16384 vitest run --config build/tests/vitest.config.ts --project unit-integration --coverage --coverage.include=src/components/BaseChat/**/*.vue --coverage.include=src/components/BaseTable/**/*.vue --coverage.include=src/components/BaseEditor/**/*.vue --coverage.include=src/components/BaseCalendar/**/*.vue --coverage.include=src/components/BaseDatePicker/**/*.vue --coverage.include=src/components/BaseFileUpload/**/*.vue --coverage.include=src/components/BaseImage/**/*.vue --coverage.include=src/components/BaseSelect/**/*.vue --coverage.include=src/components/BaseSlider/**/*.vue --coverage.include=src/components/BaseRange/**/*.vue --coverage.include=src/components/BaseTabs/**/*.vue --coverage.include=src/components/BaseTooltip/**/*.vue --coverage.include=src/components/BaseTree/**/*.vue --coverage.include=src/components/BaseSlideover/**/*.vue --coverage.include=src/components/**/model/**/*.ts --coverage.reportsDirectory=coverage/components-heavy --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:coverage:merged": "npm run test:components:coverage && npm run test:components-heavy:coverage && npm run test:composables:coverage && npm run test:utils:coverage && node scripts/merge-coverage.mjs",
    "test:vitest": "cross-env CI=true NODE_OPTIONS=--max-old-space-size=16384 vitest run --config build/tests/vitest.config.ts --project unit-integration --coverage",
    "test:e2e": "playwright test --config build/tests/playwright.config.ts --project=e2e-chromium",
    "test:e2e:dev": "cross-env STORYBOOK_SERVER=dev playwright test --config build/tests/playwright.config.ts --project=e2e-chromium",
    "test:visual": "playwright test --config build/tests/playwright.config.ts --project=visual-chromium",
    "test:visual:dev": "cross-env STORYBOOK_SERVER=dev playwright test --config build/tests/playwright.config.ts --project=visual-chromium",
    "test:visual:update": "playwright test --config build/tests/playwright.config.ts --project=visual-chromium --update-snapshots",
    "test:all": "npm run test:components:coverage && npm run test:composables:coverage && npm run test:utils:coverage && npm run test:e2e && npm run test:visual && npm run test:folders",
    "build": "npm run build:lib",
    "build:lib": "npm run build:lib:js && npm run build:lib:types && npm run build:lib:resolve-aliases",
    "build:lib:js": "vite build --config build/lib/vite.lib.config.ts && npm run build:lib:styles-css && npm run build:lib:media-css && npm run build:lib:subpath-css && npm run build:lib:tokens",
    "build:lib:styles-css": "vite build --config build/lib/vite.styles-css.config.ts",
    "build:lib:media-css": "vite build --config build/lib/vite.media-css.config.ts",
    "build:lib:subpath-css": "vite build --config build/lib/vite.subpath-css.config.ts",
    "build:lib:tokens": "node scripts/build-tokens.mjs",
    "build:lib:types": "vue-tsc -p build/lib/tsconfig.lib.json --declaration --emitDeclarationOnly",
    "build:lib:resolve-aliases": "node build/lib/resolve-aliases.mjs",
    "pack:dry": "npm run build:lib && npm pack --dry-run",
    "release": "semantic-release --extends ./build/release/semantic-release.config.cjs",
    "release:dry": "semantic-release --dry-run --extends ./build/release/semantic-release.local.config.cjs",
    "ci:validate": "npm run lint && npm run lint:styles && npm run lint:unused && npm run format:check && npm run typecheck && npm run test:unit && npm run pack:dry && npm run test:css-split && npm run test:subpaths -- --no-screenshot && npm run test:sizes && npm run test:ratchets && npm run test:folders && npm run test:custom-color",
    "ci:release": "npm run release"
  },
