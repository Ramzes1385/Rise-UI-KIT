  ],
  "prettier": {
    "useTabs": true,
    "tabWidth": 4,
    "printWidth": 140,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "endOfLine": "lf"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "selector-class-pattern": [
        "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
        {
          "message": "Класс по БЭМ: block__element--modifier в kebab-case"
        }
      ],
      "value-keyword-case": [
        "lower",
        {
          "ignoreProperties": [
            "/^--rise-font-/"
          ]
        }
      ],
      "media-feature-range-notation": "prefix",
      "selector-pseudo-class-disallowed-list": [
        [
          "dir"
        ],
        {
          "message": ":dir() ломается в сборке — используйте [dir='rtl'] &"
        }
      ],
      "at-rule-empty-line-before": null,
      "declaration-empty-line-before": null,
      "custom-property-empty-line-before": null,
      "scss/double-slash-comment-empty-line-before": null,
      "scss/comment-no-empty": null,
      "scss/at-if-no-null": null,
      "declaration-property-value-disallowed-list": [
        {
          "/^transition(-property)?$/": [
            "/(^|[\\s,])(min-|max-)?(width|height|top|left|right|bottom|inset|margin|padding)(-[a-z-]+)?($|[\\s,])/"
          ],
          "/^(transition|animation)(-duration|-delay)?$/": [
            "/(^|[\\s,(])(\\d*\\.)?\\d*[1-9]\\d*m?s($|[\\s,)])/"
          ],
          "/^(text-align|float|clear)$/": [
            "/^(left|right)$/"
          ],
          "/^(left|right)$/": [
            "/^(?!50%$)/"
          ]
        },
        {
          "severity": "error",
          "message": "Движение: переходы только по transform и opacity, длительности — токены var(--rise-duration…) (DESIGN_SYSTEM, «Движение»). RTL: text-align, float, clear — start/end, left/right — логические свойства, исключение 50% (DESIGN_SYSTEM, «Письмо справа налево»). Исключение — отключение на строку с причиной"
        }
      ],
      "property-disallowed-list": [
        [
          "/^(margin|padding|scroll-margin|scroll-padding)-(left|right)$/",
          "/^border-(left|right)(-(width|style|color))?$/",
          "/^border-(top|bottom)-(left|right)-radius$/"
        ],
        {
          "message": "RTL: логические свойства (margin-inline-start, border-inline-end, border-start-start-radius …); физические — только в файлах из списка «физических по устройству» (стрелки поповеров, индикаторы под JS, графики), см. DESIGN_SYSTEM, «Письмо справа налево»"
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/components/**/*.scss"
        ],
        "rules": {
          "comment-pattern": [
            "(?!)",
            {
              "message": "Комментариев в стилях компонентов нет"
            }
          ]
        }
      },
      {
        "files": [
          "src/components/BasePin/styles/BasePin.style.scss"
        ],
        "rules": {
          "property-no-vendor-prefix": [
            true,
            {
              "ignoreProperties": [
                "-webkit-appearance",
                "-moz-appearance"
              ]
            }
          ]
        }
      },
      {
        "files": [
          "src/components/BaseDropdown/styles/BaseDropdown.style.scss",
          "src/components/BaseTooltip/styles/BaseTooltip.style.scss",
          "src/components/BaseTour/styles/BaseTour.style.scss",
          "src/components/BaseCalendar/styles/BaseCalendar.style.scss",
          "src/components/BaseMediaPlayer/styles/BaseMediaPlayer.style.scss",
          "src/components/BaseAnchor/styles/BaseAnchor.style.scss",
          "src/styles/_mixins.scss"
        ],
        "rules": {
          "property-disallowed-list": null,
          "declaration-property-value-disallowed-list": [
            {
              "/^(transition|animation)(-duration|-delay)?$/": [
                "/(^|[\\s,(])(\\d*\\.)?\\d*[1-9]\\d*m?s($|[\\s,)])/"
              ],
              "/^transition(-property)?$/": [
                "/(^|[\\s,])(min-|max-)?(width|height|top|left|right|bottom|inset|margin|padding)(-[a-z-]+)?($|[\\s,])/"
              ]
            },
            {
              "severity": "error",
              "message": "Движение: переходы только по transform и opacity, длительности — токены var(--rise-duration…) (DESIGN_SYSTEM, «Движение»); исключение — отключение на строку с причиной"
            }
          ]
        }
      }
    ]
  },
