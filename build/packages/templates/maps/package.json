{
  "name": "@ramzes1385/rise-maps",
  "version": "0.1.0",
  "description": "Карты для Vue 3 на Rise UI Kit: BaseMap (Яндекс и Google), BaseImageMap и редактор BaseImageMapEditor — карты этажей и планов по картинке или SVG, BaseImageMap3D — 3D-карта на three.js",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map3d": {
      "types": "./dist/map3d.d.ts",
      "import": "./dist/map3d.js"
    },
    "./styles.css": "./dist/maps.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@ramzes1385/rise-ui-kit": "^2.0.0",
    "three": ">=0.180.0 <0.200.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ramzes1385/rise-ui-kit": "^2.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "sass-embedded": "^1.100.0",
    "three": "0.186.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.15",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.3"
  }
}
