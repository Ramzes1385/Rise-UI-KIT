{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/build-types",
    "target": "es2023",
    "lib": [
      "ES2023"
    ],
    "module": "esnext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "build/**/*.ts",
    "src/plugin/registry/lazyNames.ts"
  ],
  /* Код для браузера и jsdom (превью Storybook, настройка Vitest) проверяется в tsconfig.app.json */
  "exclude": [
    "build/storybook/preview.ts",
    "build/storybook/manager.ts",
    "build/storybook/theme.ts",
    "build/tests/setup-vitest.ts",
    "build/tests/visual.ts",
    "build/tests/*.spec.ts",
    "build/tests/fuzz/*.ts"
  ]
}